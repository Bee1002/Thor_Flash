<Window x:Class="Thor_Flash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thor_Flash — Flasheo Odin Samsung"
        Icon="Assets/ThorFlash_icon.png"
        Height="700" Width="980"
        MinHeight="520" MinWidth="820"
        Background="{StaticResource TfWindowBgBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="MainTabs" Padding="0,2,0,0">
            <TabItem Header="Dispositivo">
                <Border Background="{StaticResource TfGlassSurfaceBrush}"
                        BorderBrush="{StaticResource TfGlassBorderBrush}"
                        BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,0" Opacity="0.97">
                <StackPanel>
                    <TextBlock Style="{StaticResource TfHintText}" Margin="0,0,0,12"
                               Text="Detección automática en Download (WinUSB/Zadig). El indicador verde confirma sesión Odin y PIT listos."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse x:Name="ReadyIndicator" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{StaticResource TfReadyOffBrush}" ToolTip="Estado del dispositivo"/>
                        <TextBlock x:Name="ReadyLabel" VerticalAlignment="Center" Foreground="{StaticResource TfTextBrush}"
                                   Text="Esperando dispositivo en Download…"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="DeviceCombo" Width="400" Margin="0,0,8,0"
                                  DisplayMemberPath="DisplayName" IsEnabled="False"/>
                        <Button x:Name="RefreshButton" Content="Actualizar" Width="90" Margin="0,0,8,0" Click="RefreshButton_Click"/>
                        <Button x:Name="DiagnoseButton" Content="Diagnóstico" Width="95" Margin="0,0,8,0" Click="DiagnoseButton_Click"/>
                        <Button x:Name="DriverHelpButton" Content="Guía WinUSB" Width="95" Margin="0,0,8,0" Click="DriverHelpButton_Click"/>
                        <Button x:Name="ConnectButton" Content="Conectar USB" Width="110" Margin="0,0,8,0"
                                Style="{StaticResource TfPrimaryButton}" Click="ConnectButton_Click"/>
                        <Button x:Name="BeginOdinButton" Content="Iniciar Odin" Width="100" Margin="0,0,8,0"
                                Style="{StaticResource TfPrimaryButton}" Click="BeginOdinButton_Click" IsEnabled="False"/>
                        <Button x:Name="EndOdinButton" Content="Fin sesión" Width="90" Margin="0,0,8,0" Click="EndOdinButton_Click" IsEnabled="False"/>
                        <Button x:Name="DisconnectButton" Content="Desconectar" Width="95" Click="DisconnectButton_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="OdinInfoText" TextWrapping="Wrap" Foreground="{StaticResource TfTextMutedBrush}"/>
                </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Flash firmware" x:Name="FlashTab" IsEnabled="False">
                <Border Background="{StaticResource TfGlassSurfaceBrush}"
                        BorderBrush="{StaticResource TfGlassBorderBrush}"
                        BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,0" Opacity="0.97">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource TfHintText}" Margin="0,0,0,6"
                               Text="Carpeta o un solo .tar/.tar.md5 de Odin. Escanear cruza nombres del archivo con el PIT del teléfono."/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="TarFolderBox" Width="400" Margin="0,0,8,0"
                                 ToolTip="Carpeta con AP/BL/CP/CSC .tar.md5, o ruta a un único .tar"/>
                        <Button Content="Carpeta…" Width="72" Margin="0,0,4,0" Click="BrowseTarFolder_Click"/>
                        <Button Content=".tar…" Width="52" Margin="0,0,8,0" Click="BrowseTarFile_Click"/>
                        <Button x:Name="ScanTarButton" Content="Escanear" Width="88" Margin="0,0,8,0" Click="ScanTarButton_Click"/>
                        <Button Content="Todo" Width="50" Margin="0,0,4,0" Click="SelectAllPartitions_Click"/>
                        <Button Content="Nada" Width="50" Click="SelectNoPartitions_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="EfsClearCheck" Content="EFS Clear" Margin="0,0,16,0"
                                  Checked="OdinOptionChanged" Unchecked="OdinOptionChanged"
                                  ToolTip="Borra partición EFS al flashear (opción Odin «EFS Clear»)."/>
                        <CheckBox x:Name="AutoRebootCheck" Content="Reinicio automático" IsChecked="True"
                                  Checked="OdinOptionChanged" Unchecked="OdinOptionChanged"
                                  ToolTip="Reinicia por protocolo al terminar el flash. No uses los botones físicos en Download."/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="3" Style="{StaticResource TfPanelScrollViewer}" Margin="0,0,0,8">
                        <ItemsControl x:Name="PartitionsList" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,4">
                                        <Expander.Header>
                                            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}"
                                                           Style="{StaticResource TfSlotLabel}"
                                                           VerticalAlignment="Center" MinWidth="48"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SelectionSummary}"
                                                           Style="{StaticResource TfHintText}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Partitions}" Margin="8,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="16,3,0,3">
                                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TfTextBrush}"/>
                                                        <TextBlock Text=" → " Style="{StaticResource TfHintText}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PitEntry.Partition}" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TfTextMutedBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button x:Name="FlashTarButton" Content="Flashear selección" Width="140"
                                Style="{StaticResource TfPrimaryButton}" Click="FlashTarButton_Click"/>
                    </StackPanel>
                </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Archivo suelto" x:Name="SingleFileTab" IsEnabled="False">
                <Border Background="{StaticResource TfGlassSurfaceBrush}"
                        BorderBrush="{StaticResource TfGlassBorderBrush}"
                        BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,0" Opacity="0.97">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="SingleFileBox" Width="480" Margin="0,0,8,0"/>
                        <Button Content="Archivo…" Width="80" Margin="0,0,8,0" Click="BrowseSingleFile_Click"/>
                        <Button x:Name="FlashFileButton" Content="Flashear archivo" Width="130"
                                Style="{StaticResource TfPrimaryButton}" Click="FlashFileButton_Click"/>
                    </StackPanel>
                    <ComboBox x:Name="PartitionCombo" Width="480" Margin="0,0,0,8"
                              DisplayMemberPath="Partition" IsEnabled="False"/>
                    <TextBlock Style="{StaticResource TfHintText}" MaxWidth="520"
                               Text="Si el nombre del archivo coincide con el PIT, se elige la partición automáticamente."/>
                </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="PIT" x:Name="PitTab" IsEnabled="False">
                <Border Background="{StaticResource TfGlassSurfaceBrush}"
                        BorderBrush="{StaticResource TfGlassBorderBrush}"
                        BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,0" Opacity="0.97">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="DumpPitButton" Content="Volcar PIT del dispositivo" Width="180" Margin="0,0,8,0" Click="DumpPitButton_Click"/>
                        <Button x:Name="PrintPitDeviceButton" Content="Ver PIT (dispositivo)" Width="150" Margin="0,0,8,0" Click="PrintPitDeviceButton_Click"/>
                        <Button Content="Ver PIT (archivo)…" Width="130" Margin="0,0,8,0" Click="PrintPitFileButton_Click"/>
                        <Button x:Name="FactoryResetButton" Content="Borrar userdata" Width="120" Margin="0,0,8,0" Click="FactoryResetButton_Click"/>
                        <Button x:Name="FlashPitButton" Content="Flashear PIT…" Width="110" Click="FlashPitButton_Click"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="PitViewBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                             Style="{StaticResource TfLogTextBox}"/>
                </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Avanzado" x:Name="AdvancedTab" IsEnabled="False">
                <Border Background="{StaticResource TfGlassSurfaceBrush}"
                        BorderBrush="{StaticResource TfGlassBorderBrush}"
                        BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,0" Opacity="0.97">
                <StackPanel>
                    <TextBlock Style="{StaticResource TfHintText}" Margin="0,0,0,10"
                               Text="Comandos avanzados: borrar partición, código de región y opciones extra de protocolo."/>
                    <TextBlock Text="Código de región (setRegion, 3 letras)" Style="{StaticResource TfSectionTitle}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox x:Name="RegionCodeBox" Width="60" MaxLength="3" CharacterCasing="Upper" Margin="0,0,8,0"/>
                        <Button x:Name="SetRegionButton" Content="Aplicar región" Width="110" Click="SetRegionButton_Click"/>
                    </StackPanel>
                    <TextBlock Text="Borrar partición (erasePartition — usa tamaño del PIT)" Style="{StaticResource TfSectionTitle}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="ErasePartitionCombo" Width="280" Margin="0,0,8,0"
                                  DisplayMemberPath="Partition"/>
                        <Button x:Name="ErasePartitionButton" Content="Borrar partición" Width="130" Click="ErasePartitionButton_Click"/>
                    </StackPanel>
                </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Reinicio" x:Name="RebootTab" IsEnabled="False">
                <Border Background="{StaticResource TfGlassSurfaceBrush}"
                        BorderBrush="{StaticResource TfGlassBorderBrush}"
                        BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,0" Opacity="0.97">
                <StackPanel>
                    <Button Content="Reiniciar dispositivo" Width="160" Margin="0,0,0,8" HorizontalAlignment="Left" Click="RebootButton_Click"/>
                    <Button Content="Reiniciar a modo Download" Width="200" Margin="0,0,0,8" HorizontalAlignment="Left" Click="RebootOdinButton_Click"/>
                    <TextBlock Style="{StaticResource TfHintText}"
                               Text="Usa estos botones o «Reinicio automático» tras flashear. No reinicies con botones físicos en Download: puede aparecer la pantalla azul «An error has occurred while updating the device software»."/>
                </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Margin="0,8,0,0"
                Background="{StaticResource TfLogBgBrush}"
                BorderBrush="{StaticResource TfGlassBorderBrush}"
                BorderThickness="1" CornerRadius="2" Opacity="0.96">
            <RichTextBox x:Name="LogBox"
                         Style="{StaticResource TfLogRichTextBox}"
                         BorderThickness="0" Background="Transparent"/>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,8,0,6">
            <ProgressBar x:Name="FlashPartitionProgress" Style="{StaticResource TfProgressPartitionBar}"
                         Minimum="0" Maximum="100"/>
            <ProgressBar x:Name="FlashProgress" Style="{StaticResource TfProgressBatchBar}"
                         Minimum="0" Maximum="100" Margin="0,3,0,0"/>
            <Grid x:Name="FlashStatsPanel" Margin="0,5,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TotalSizeText" Style="{StaticResource TfFlashStatsText}"
                           Text="Total Size : 0 MB"/>
                <TextBlock Grid.Column="1" x:Name="WrittenSizeText" Style="{StaticResource TfFlashStatsText}"
                           HorizontalAlignment="Center" Text="Written Size : 0 MB"/>
                <TextBlock Grid.Column="2" x:Name="TransferRateText" Style="{StaticResource TfFlashStatsText}"
                           HorizontalAlignment="Right" Text="Transfer Rate : 0 KB/s"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" MinWidth="88"
                       Style="{StaticResource TfStatusBar}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="FlashStatusText" Margin="12,0,12,0"
                       Style="{StaticResource TfFlashActivityText}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0">
                <Hyperlink NavigateUri="https://phone-parts.pages.dev/dashboard"
                           RequestNavigate="WebsiteLink_RequestNavigate"
                           Style="{StaticResource TfWebsiteLink}">
                    Phone Parts
                </Hyperlink>
            </TextBlock>
            <Button Grid.Column="3" x:Name="StopButton" Style="{StaticResource TfStopButton}"
                    IsEnabled="False" Click="StopButton_Click"/>
        </Grid>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta Odin Flash: fondo #263238 · acento #2E8276 · log #59B369 -->
    <Color x:Key="TfSurfaceColor">#2C3A40</Color>
    <Color x:Key="TfBorderStrongColor">#546E7A</Color>
    <Color x:Key="TfAccentMutedColor">#2E8276</Color>
    <Color x:Key="TfAccentBrightColor">#3D9688</Color>
    <Color x:Key="TfTextColor">#ECEFF1</Color>
    <Color x:Key="TfTextMutedColor">#B0BEC5</Color>
    <Color x:Key="TfTextSubtleColor">#90A4AE</Color>
    <Color x:Key="TfLogBgColor">#1A2328</Color>
    <Color x:Key="TfLogTextColor">#59B369</Color>
    <Color x:Key="TfProgressTrackColor">#141A1E</Color>
    <Color x:Key="TfProgressFillColor">#59B369</Color>
    <Color x:Key="TfProgressFillDimColor">#478F55</Color>
    <Color x:Key="TfReadyWaitingColor">#2E8276</Color>
    <Color x:Key="TfStatusConnectedColor">#59B369</Color>
    <Color x:Key="TfStatusDisconnectedColor">#E57373</Color>
    <Color x:Key="TfStopButtonColor">#8B4545</Color>
    <Color x:Key="TfStopButtonBorderColor">#E57373</Color>

    <!-- Superficies con transparencia (efecto panel Odin Flash) -->
    <Color x:Key="TfGlassSurfaceColor">#B3283238</Color>
    <Color x:Key="TfGlassInputColor">#CC1E272C</Color>
    <Color x:Key="TfGlassBorderColor">#66455A64</Color>
    <Color x:Key="TfTabSelectedColor">#552E8276</Color>

    <SolidColorBrush x:Key="TfSurfaceBrush" Color="{StaticResource TfSurfaceColor}"/>
    <SolidColorBrush x:Key="TfBorderStrongBrush" Color="{StaticResource TfBorderStrongColor}"/>
    <SolidColorBrush x:Key="TfAccentMutedBrush" Color="{StaticResource TfAccentMutedColor}"/>
    <SolidColorBrush x:Key="TfAccentBrightBrush" Color="{StaticResource TfAccentBrightColor}"/>
    <SolidColorBrush x:Key="TfTextBrush" Color="{StaticResource TfTextColor}"/>
    <SolidColorBrush x:Key="TfTextMutedBrush" Color="{StaticResource TfTextMutedColor}"/>
    <SolidColorBrush x:Key="TfTextSubtleBrush" Color="{StaticResource TfTextSubtleColor}"/>
    <SolidColorBrush x:Key="TfLogBgBrush" Color="{StaticResource TfLogBgColor}"/>
    <SolidColorBrush x:Key="TfLogTextBrush" Color="{StaticResource TfLogTextColor}"/>
    <SolidColorBrush x:Key="TfProgressBrush" Color="{StaticResource TfProgressFillColor}"/>
    <SolidColorBrush x:Key="TfProgressDimBrush" Color="{StaticResource TfProgressFillDimColor}"/>
    <SolidColorBrush x:Key="TfProgressTrackBrush" Color="{StaticResource TfProgressTrackColor}"/>
    <SolidColorBrush x:Key="TfReadyWaitingBrush" Color="{StaticResource TfReadyWaitingColor}"/>
    <SolidColorBrush x:Key="TfStatusConnectedBrush" Color="{StaticResource TfStatusConnectedColor}"/>
    <SolidColorBrush x:Key="TfStatusDisconnectedBrush" Color="{StaticResource TfStatusDisconnectedColor}"/>
    <SolidColorBrush x:Key="TfStopButtonBrush" Color="{StaticResource TfStopButtonColor}"/>
    <SolidColorBrush x:Key="TfStopButtonBorderBrush" Color="{StaticResource TfStopButtonBorderColor}"/>
    <SolidColorBrush x:Key="TfGlassSurfaceBrush" Color="{StaticResource TfGlassSurfaceColor}"/>
    <SolidColorBrush x:Key="TfGlassInputBrush" Color="{StaticResource TfGlassInputColor}"/>
    <SolidColorBrush x:Key="TfGlassBorderBrush" Color="{StaticResource TfGlassBorderColor}"/>
    <SolidColorBrush x:Key="TfTabSelectedBrush" Color="{StaticResource TfTabSelectedColor}"/>

    <LinearGradientBrush x:Key="TfWindowBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A3238" Offset="0"/>
        <GradientStop Color="#1E272C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TfPrimaryButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A9688" Offset="0"/>
        <GradientStop Color="#2E8276" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Ventana ── -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource TfWindowBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
    </Style>

    <!-- ── Botones ── -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TfGlassSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}"
                            Opacity="0.95">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CC455A64"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TfBorderStrongBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#AA37474F"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TfPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource TfPrimaryButtonBgBrush}"/>
        <Setter Property="BorderBrush" Value="#803D9688"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}"
                            Opacity="0.94">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#42A896" Offset="0"/>
                                        <GradientStop Color="#359688" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CC256B61"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Pestañas ── -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,4,0,0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TfTextSubtleBrush}"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,1,0"
                            CornerRadius="2,2,0,0"
                            Opacity="0.88">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TfTabSelectedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TfAccentMutedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TfLogTextBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#332E8276"/>
                            <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Entradas ── -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource TfGlassInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{StaticResource TfLogTextBrush}"/>
        <Setter Property="Opacity" Value="0.96"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource TfGlassInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Opacity" Value="0.96"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource TfSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#552E8276"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#772E8276"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── CheckBox estilo Odin (acento verde) ── -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="15" Height="15"
                                Background="{StaticResource TfGlassInputBrush}"
                                BorderBrush="{StaticResource TfGlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Path x:Name="Mark"
                                  Data="M 2,7 L 5,10 L 11,3"
                                  Stroke="{StaticResource TfLogTextBrush}"
                                  StrokeThickness="2"
                                  Visibility="Collapsed"
                                  Margin="1"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TfAccentMutedBrush}"/>
                            <Setter TargetName="Box" Property="Background" Value="#442E8276"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TfAccentBrightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Barras de progreso estilo Odin Flash (plano, verde, sin bordes) ── -->
    <Style x:Key="TfOdinProgressBarBase" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource TfProgressTrackBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource TfOdinProgressBarBase}">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TfProgressBrush}"/>
    </Style>

    <Style x:Key="TfProgressPartitionBar" TargetType="ProgressBar" BasedOn="{StaticResource TfOdinProgressBarBase}">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="{StaticResource TfProgressDimBrush}"/>
    </Style>

    <Style x:Key="TfProgressBatchBar" TargetType="ProgressBar" BasedOn="{StaticResource TfOdinProgressBarBase}">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TfProgressBrush}"/>
    </Style>

    <!-- ── Panel / lista particiones ── -->
    <Style x:Key="TfPanelScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Background" Value="{StaticResource TfGlassSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Opacity" Value="0.97"/>
    </Style>

    <!-- ── Expander (BL / AP / CP…) ── -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="2,5"/>
        <Setter Property="Opacity" Value="0.98"/>
    </Style>

    <!-- ── Log ── -->
    <Style x:Key="TfLogRichTextBox" TargetType="RichTextBox">
        <Setter Property="Background" Value="{StaticResource TfLogBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Opacity" Value="0.96"/>
    </Style>

    <Style x:Key="TfLogTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource TfLogBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfLogTextBrush}"/>
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Opacity" Value="0.96"/>
    </Style>

    <!-- Fase flash: panel log semitransparente (Odin_Flash / OdinPanelBorder, solo esta pantalla) -->
    <Color x:Key="TfFlashLogPanelBgColor">#1A1A2328</Color>
    <Color x:Key="TfFlashLogPanelBorderColor">#CC62C574</Color>
    <Color x:Key="TfFlashLogPanelOuterColor">#6848B088</Color>
    <Color x:Key="TfFlashLogFooterBgColor">#1A1E272C</Color>
    <Color x:Key="TfFlashLogHeaderColor">#6FD07E</Color>
    <SolidColorBrush x:Key="TfFlashLogPanelBgBrush" Color="{StaticResource TfFlashLogPanelBgColor}"/>
    <SolidColorBrush x:Key="TfFlashLogPanelBorderBrush" Color="{StaticResource TfFlashLogPanelBorderColor}"/>
    <SolidColorBrush x:Key="TfFlashLogPanelOuterBrush" Color="{StaticResource TfFlashLogPanelOuterColor}"/>
    <SolidColorBrush x:Key="TfFlashLogFooterBgBrush" Color="{StaticResource TfFlashLogFooterBgColor}"/>
    <SolidColorBrush x:Key="TfFlashLogHeaderBrush" Color="{StaticResource TfFlashLogHeaderColor}"/>

    <LinearGradientBrush x:Key="TfFlashPhaseBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#752E8276" Offset="0"/>
        <GradientStop Color="#442A3238" Offset="0.45"/>
        <GradientStop Color="#6642A892" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="TfFlashLogPanelOuter" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TfFlashLogPanelOuterBrush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="TfFlashLogPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TfFlashLogPanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfFlashLogPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="TfFlashLogFooterInner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TfFlashLogFooterBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfFlashLogPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style x:Key="TfFlashLogFooterPanel" TargetType="Border" BasedOn="{StaticResource TfFlashLogPanelOuter}">
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="1"/>
    </Style>

    <Style x:Key="TfFlashLogHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TfFlashLogHeaderBrush}"/>
    </Style>

    <Style x:Key="TfFlashLogRichTextBox" TargetType="RichTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RichTextBox">
                    <Border Background="Transparent" BorderThickness="0">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Textos auxiliares ── -->
    <Style x:Key="TfHintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextSubtleBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Opacity" Value="0.92"/>
    </Style>

    <Style x:Key="TfSlotLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfLogTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TfStatusBar" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TfFlashStatsText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TfFlashActivityText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfLogTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <Style x:Key="TfWebsiteLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource TfAccentBrightBrush}"/>
        <Setter Property="TextDecorations" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TfLogTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TfStopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Content" Value="Stop"/>
        <Setter Property="Width" Value="72"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}"
                            Opacity="{TemplateBinding Opacity}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TfStopButtonBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TfStopButtonBorderBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#A0525252"/>
                            <Setter Property="Opacity" Value="1"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#99704040"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

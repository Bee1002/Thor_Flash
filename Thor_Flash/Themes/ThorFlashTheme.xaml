<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta minimalista (grises neutros) -->
    <Color x:Key="TfBgColor">#141414</Color>
    <Color x:Key="TfSurfaceColor">#1C1C1C</Color>
    <Color x:Key="TfSurfaceAltColor">#262626</Color>
    <Color x:Key="TfBorderColor">#333333</Color>
    <Color x:Key="TfBorderStrongColor">#484848</Color>
    <Color x:Key="TfAccentColor">#E5E5E5</Color>
    <Color x:Key="TfAccentHoverColor">#F0F0F0</Color>
    <Color x:Key="TfAccentMutedColor">#8A8A8A</Color>
    <Color x:Key="TfTextColor">#E8E8E8</Color>
    <Color x:Key="TfTextMutedColor">#A3A3A3</Color>
    <Color x:Key="TfTextSubtleColor">#737373</Color>
    <Color x:Key="TfLogBgColor">#111111</Color>
    <Color x:Key="TfLogTextColor">#C8C8C8</Color>

    <SolidColorBrush x:Key="TfBgBrush" Color="{StaticResource TfBgColor}"/>
    <SolidColorBrush x:Key="TfSurfaceBrush" Color="{StaticResource TfSurfaceColor}"/>
    <SolidColorBrush x:Key="TfSurfaceAltBrush" Color="{StaticResource TfSurfaceAltColor}"/>
    <SolidColorBrush x:Key="TfBorderBrush" Color="{StaticResource TfBorderColor}"/>
    <SolidColorBrush x:Key="TfBorderStrongBrush" Color="{StaticResource TfBorderStrongColor}"/>
    <SolidColorBrush x:Key="TfAccentBrush" Color="{StaticResource TfAccentColor}"/>
    <SolidColorBrush x:Key="TfAccentHoverBrush" Color="{StaticResource TfAccentHoverColor}"/>
    <SolidColorBrush x:Key="TfAccentMutedBrush" Color="{StaticResource TfAccentMutedColor}"/>
    <SolidColorBrush x:Key="TfTextBrush" Color="{StaticResource TfTextColor}"/>
    <SolidColorBrush x:Key="TfTextMutedBrush" Color="{StaticResource TfTextMutedColor}"/>
    <SolidColorBrush x:Key="TfTextSubtleBrush" Color="{StaticResource TfTextSubtleColor}"/>
    <SolidColorBrush x:Key="TfLogBgBrush" Color="{StaticResource TfLogBgColor}"/>
    <SolidColorBrush x:Key="TfLogTextBrush" Color="{StaticResource TfLogTextColor}"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource TfBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TfSurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#303030"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TfBorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#222222"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Acción principal: mismo tono, un poco más claro y borde definido -->
    <Style x:Key="TfPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#2E2E2E"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderStrongBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5C5C5C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TfTextSubtleBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TfAccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource TfSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{StaticResource TfTextBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource TfSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource TfSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="RowBackground" Value="{StaticResource TfSurfaceBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource TfSurfaceAltBrush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource TfSurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource TfSurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfAccentMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="TfLogTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource TfLogBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfLogTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="TfHintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextSubtleBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TfSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="TfStatusBar" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextSubtleBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta Odin Flash: #263238 / #2e8276 / log #59b369 -->
    <Color x:Key="TfBgColor">#263238</Color>
    <Color x:Key="TfSurfaceColor">#2C3A40</Color>
    <Color x:Key="TfSurfaceAltColor">#37474F</Color>
    <Color x:Key="TfBorderColor">#455A64</Color>
    <Color x:Key="TfBorderStrongColor">#546E7A</Color>
    <Color x:Key="TfAccentColor">#FFFFFF</Color>
    <Color x:Key="TfAccentHoverColor">#ECEFF1</Color>
    <Color x:Key="TfAccentMutedColor">#2E8276</Color>
    <Color x:Key="TfTextColor">#ECEFF1</Color>
    <Color x:Key="TfTextMutedColor">#B0BEC5</Color>
    <Color x:Key="TfTextSubtleColor">#90A4AE</Color>
    <Color x:Key="TfLogBgColor">#263238</Color>
    <Color x:Key="TfLogTextColor">#59B369</Color>
    <Color x:Key="TfProgressColor">#2E8276</Color>
    <Color x:Key="TfReadyColor">#59B369</Color>
    <Color x:Key="TfReadyWaitingColor">#2E8276</Color>
    <Color x:Key="TfReadyOffColor">#546E7A</Color>

    <SolidColorBrush x:Key="TfBgBrush" Color="{StaticResource TfBgColor}"/>
    <SolidColorBrush x:Key="TfSurfaceBrush" Color="{StaticResource TfSurfaceColor}"/>
    <SolidColorBrush x:Key="TfSurfaceAltBrush" Color="{StaticResource TfSurfaceAltColor}"/>
    <SolidColorBrush x:Key="TfBorderBrush" Color="{StaticResource TfBorderColor}"/>
    <SolidColorBrush x:Key="TfBorderStrongBrush" Color="{StaticResource TfBorderStrongColor}"/>
    <SolidColorBrush x:Key="TfAccentBrush" Color="{StaticResource TfAccentColor}"/>
    <SolidColorBrush x:Key="TfAccentHoverBrush" Color="{StaticResource TfAccentHoverColor}"/>
    <SolidColorBrush x:Key="TfAccentMutedBrush" Color="{StaticResource TfAccentMutedColor}"/>
    <SolidColorBrush x:Key="TfTextBrush" Color="{StaticResource TfTextColor}"/>
    <SolidColorBrush x:Key="TfTextMutedBrush" Color="{StaticResource TfTextMutedColor}"/>
    <SolidColorBrush x:Key="TfTextSubtleBrush" Color="{StaticResource TfTextSubtleColor}"/>
    <SolidColorBrush x:Key="TfLogBgBrush" Color="{StaticResource TfLogBgColor}"/>
    <SolidColorBrush x:Key="TfLogTextBrush" Color="{StaticResource TfLogTextColor}"/>
    <SolidColorBrush x:Key="TfProgressBrush" Color="{StaticResource TfProgressColor}"/>
    <SolidColorBrush x:Key="TfReadyBrush" Color="{StaticResource TfReadyColor}"/>
    <SolidColorBrush x:Key="TfReadyWaitingBrush" Color="{StaticResource TfReadyWaitingColor}"/>
    <SolidColorBrush x:Key="TfReadyOffBrush" Color="{StaticResource TfReadyOffColor}"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource TfBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TfSurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#455A64"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TfBorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#37474F"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TfPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#2E8276"/>
        <Setter Property="BorderBrush" Value="#3D9688"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            Opacity="0.92">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#359688"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#256B61"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TfTextSubtleBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TfAccentMutedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource TfSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{StaticResource TfTextBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource TfSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource TfSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="RowBackground" Value="{StaticResource TfSurfaceBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource TfSurfaceAltBrush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource TfSurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource TfSurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfProgressBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Opacity" Value="0.8"/>
    </Style>

    <Style x:Key="TfLogRichTextBox" TargetType="RichTextBox">
        <Setter Property="Background" Value="{StaticResource TfLogBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="FontFamily" Value="Courier New"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <Style x:Key="TfLogTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource TfLogBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TfLogTextBrush}"/>
        <Setter Property="FontFamily" Value="Courier New"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource TfBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="4,6"/>
    </Style>

    <Style x:Key="TfHintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextSubtleBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TfSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
    </Style>

    <Style x:Key="TfStatusBar" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TfTextSubtleBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

</ResourceDictionary>
